server {
    listen 80;
    server_name _;
    proxy_connect_timeout 60s;
    proxy_read_timeout 60s;

    location /api/ {
        proxy_pass http://{{ nginx_ingress_ip }}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /openapi.json {
        proxy_pass http://{{ nginx_ingress_ip }}/api/openapi.json;
        proxy_set_header Host $host;
    }

    location /grafana/ {
        proxy_pass http://{{ nginx_ingress_ip }}/grafana/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto http;
    }

    location ~* ^/prometheus(.*) {
        proxy_pass http://{{ nginx_ingress_ip }}/prometheus$1;
        proxy_set_header Host $host;
    }

    location ~* ^/alertmanager(.*) {
        proxy_pass http://{{ nginx_ingress_ip }}/alertmanager$1;
        proxy_set_header Host $host;
    }

    location /argocd/ {
        proxy_pass http://{{ nginx_ingress_ip }}/argocd/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto http;
    }

    location /keycloak/ {
        proxy_pass http://{{ nginx_ingress_ip }}/keycloak/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto http;
    }

    location /admin/ {
        proxy_pass http://{{ nginx_ingress_ip }}/admin/;
        proxy_set_header Host $host;
    }

    location /realms/ {
        proxy_pass http://{{ nginx_ingress_ip }}/realms/;
        proxy_set_header Host $host;
    }

    location /resources/ {
        proxy_pass http://{{ nginx_ingress_ip }}/resources/;
        proxy_set_header Host $host;
    }

    location /vault/ {
        proxy_pass http://{{ nginx_ingress_ip }}/vault/;
        proxy_set_header Host $host;
    }

    location /ui/ {
        proxy_pass http://{{ nginx_ingress_ip }}/ui/;
        proxy_set_header Host $host;
    }

    location /v1/ {
        proxy_pass http://{{ nginx_ingress_ip }}/v1/;
        proxy_set_header Host $host;
    }
}
